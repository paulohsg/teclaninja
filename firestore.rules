rules_version = '2';

// Regras de segurança do TeclaNinja.
// IMPORTANTE: coloque aqui os mesmos e-mails de professor que estão em public/js/config.js
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function professor() {
      return logado() && request.auth.token.email in [
        'paulo15356@go.docente.senai.br'
      ];
    }

    // Alunos entram com nome + turma + senha. O login vira um e-mail interno
    // "primeiro.ultimo.codigo@aluno.teclaninja.example", e o documento do aluno
    // usa "primeiro.ultimo.codigo" como identificador.
    function aluno(id) {
      return logado() && request.auth.token.email == id + '@aluno.teclaninja.example';
    }
    // Leitura do próprio documento (aluno, ou professor praticando com a conta Google).
    function dono(id) {
      return logado() && (request.auth.uid == id || aluno(id));
    }
    function meuDoc() {
      return get(/databases/$(database)/documents/alunos/$(request.auth.token.email.split('@')[0])).data;
    }

    // Configurações do professor (documento config/curso). Sem o documento, tudo liberado.
    function config(campo) {
      let curso = /databases/$(database)/documents/config/curso;
      return !exists(curso) || get(curso).data.get(campo, true) != false;
    }
    function cursoLiberado() { return config('liberado'); }
    function fotosLiberadas() { return config('fotosLiberadas'); }
    function cadastroLiberado() { return config('cadastroLiberado'); }

    // Nomes: só letras, espaço, hífen, apóstrofo e ponto (nada de símbolos ou textos longos).
    function nomeValido(s) {
      return s is string && s.matches("^[\\p{L}\\p{M}0-9' .-]{1,30}$");
    }

    // Primeiro acesso: o perfil precisa bater com o login e a turma precisa existir.
    function perfilNovoValido(id) {
      let d = request.resource.data;
      return d.get('foto', '') == '' && d.get('fotoBloqueada', false) == false
        && nomeValido(d.get('primeiro', '')) && nomeValido(d.get('ultimo', ''))
        && d.get('nome', '') == d.primeiro + ' ' + d.ultimo
        && d.get('turma', '') is string && d.turma.lower() == id.split('[.]')[2]
        && exists(/databases/$(database)/documents/turmas/$(d.turma))
        && d.get('xp', 0) == 0 && d.get('melhorPpm', 0) == 0;
    }

    // O aluno salva o progresso, mas não muda nome, turma nem escola,
    // e o XP só sobe aos poucos (impede "trapaça" pelo navegador).
    function progressoValido() {
      let d = request.resource.data;
      let a = resource.data;
      let mudou = d.diff(a).affectedKeys();
      return !mudou.hasAny(['uid', 'email', 'nome', 'primeiro', 'ultimo', 'escola', 'turma', 'turmaNome', 'criadoEm'])
        && d.get('xp', 0) is int && d.get('xp', 0) >= a.get('xp', 0) && d.get('xp', 0) <= a.get('xp', 0) + 2000
        && d.get('melhorPpm', 0) is number && d.get('melhorPpm', 0) <= 250
        && d.get('moedas', 0) is int && d.get('moedas', 0) >= 0;
    }

    // Fotos de perfil: o professor pode desligar a troca para todos (config/curso.fotosLiberadas)
    // ou bloquear um aluno (campo fotoBloqueada). Só miniaturas JPEG pequenas são aceitas.
    function fotoValida() {
      let f = request.resource.data.get('foto', '');
      return f == '' || (f is string && f.size() < 60000 && f.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    function mudancaDeFotoPermitida() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return !mudou.hasAny(['fotoBloqueada'])
        && (!mudou.hasAny(['foto']) || (resource.data.get('fotoBloqueada', false) != true && fotosLiberadas() && fotoValida()));
    }

    // Progresso de cada aluno: só o próprio aluno e o professor leem.
    // Com o curso pausado, o aluno não consegue salvar progresso.
    // O primeiro acesso (criar o perfil) só funciona com o "Primeiro acesso" liberado no painel.
    match /alunos/{uid} {
      allow read: if dono(uid) || professor();
      allow create: if professor() || (aluno(uid) && cadastroLiberado() && perfilNovoValido(uid));
      allow update: if professor() || (aluno(uid) && cursoLiberado() && mudancaDeFotoPermitida() && progressoValido());
      allow delete: if professor();

      match /sessoes/{id} {
        allow read: if dono(uid) || professor();
        allow create: if professor() || (aluno(uid) && cursoLiberado());
        allow delete: if professor();
      }
    }

    // Ranking: cópia resumida do perfil. Cada aluno só vê o ranking da própria turma,
    // e os números precisam ser iguais aos do perfil (nome curto, XP, foto, turma).
    function rankingValido(uid) {
      let r = request.resource.data;
      let a = get(/databases/$(database)/documents/alunos/$(uid)).data;
      return r.keys().hasOnly(['uid', 'nome', 'foto', 'turma', 'xp', 'nivel', 'melhorPpm', 'licoes', 'avatar'])
        && r.get('uid', '') == uid && r.get('turma', '') == a.get('turma', '-')
        && r.get('xp', 0) == a.get('xp', 0) && r.get('melhorPpm', 0) == a.get('melhorPpm', 0)
        && r.get('foto', '') == a.get('foto', '')
        && r.get('nome', '') is string && r.nome.split(' ')[0] == a.get('primeiro', '-')
        && (r.nome == a.primeiro || r.nome.matches('^[^ ]+ [^ ][.]$'))
        && r.get('nivel', 1) is int && r.get('nivel', 1) >= 1 && r.get('nivel', 1) <= 20
        && r.get('licoes', 0) is int && r.get('licoes', 0) >= 0 && r.get('licoes', 0) <= 200
        && r.get('avatar', {}) is map && r.get('avatar', {}).size() <= 8;
    }
    match /ranking/{uid} {
      allow read: if professor() || (logado() && resource.data.turma == meuDoc().turma);
      allow create, update: if professor() || (aluno(uid) && rankingValido(uid));
      allow delete: if professor();
    }

    // Configurações do curso: todos leem (a tela de login precisa); só o professor muda.
    match /config/{doc} {
      allow read: if true;
      allow write: if professor();
    }

    // Turmas: a lista de escolas e turmas aparece na tela de login (antes de entrar).
    // Só o professor cria e apaga.
    match /turmas/{codigo} {
      allow read: if true;
      allow write: if professor();
    }
  }
}
