rules_version = '2';

// Regras de segurança do TeclaNinja.
// IMPORTANTE: coloque aqui os mesmos e-mails de professor que estão em public/js/config.js
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function professor() {
      return logado() && request.auth.token.email in [
        'paulo15356@go.docente.senai.br'
      ];
    }

    // Alunos entram com nome + turma + senha. O login vira um e-mail interno
    // "primeiro.ultimo.codigo@aluno.teclaninja.example", e o documento do aluno
    // usa "primeiro.ultimo.codigo" como identificador.
    function dono(id) {
      return logado() && (request.auth.uid == id
        || request.auth.token.email == id + '@aluno.teclaninja.example');
    }

    // O professor pode pausar o curso (botão no painel). Sem o documento, está liberado.
    function cursoLiberado() {
      let curso = /databases/$(database)/documents/config/curso;
      return !exists(curso) || get(curso).data.get('liberado', true) != false;
    }

    // Fotos de perfil: o professor pode desligar a troca para todos (config/curso.fotosLiberadas)
    // ou bloquear um aluno (campo fotoBloqueada). Só miniaturas JPEG pequenas são aceitas.
    function fotosLiberadas() {
      let curso = /databases/$(database)/documents/config/curso;
      return !exists(curso) || get(curso).data.get('fotosLiberadas', true) != false;
    }
    function fotoValida() {
      let f = request.resource.data.get('foto', '');
      return f == '' || (f is string && f.size() < 60000 && f.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    function mudancaDeFotoPermitida() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return !mudou.hasAny(['fotoBloqueada'])
        && (!mudou.hasAny(['foto']) || (resource.data.get('fotoBloqueada', false) != true && fotosLiberadas() && fotoValida()));
    }

    // Progresso de cada aluno: só o próprio aluno e o professor leem.
    // Com o curso pausado, o aluno não consegue salvar progresso (só criar o perfil no primeiro acesso).
    match /alunos/{uid} {
      allow read: if dono(uid) || professor();
      allow create: if professor() || (dono(uid) && request.resource.data.get('foto', '') == ''
        && request.resource.data.get('fotoBloqueada', false) == false);
      allow update: if professor() || (dono(uid) && cursoLiberado() && mudancaDeFotoPermitida());
      allow delete: if professor();

      match /sessoes/{id} {
        allow read: if dono(uid) || professor();
        allow create: if dono(uid) && cursoLiberado();
        allow delete: if professor();
      }
    }

    // Ranking: só nome, nível e XP (visível para quem está logado).
    // A foto no ranking precisa ser a mesma do perfil (assim o aluno não escapa de uma remoção).
    match /ranking/{uid} {
      allow read: if logado();
      allow write: if professor() || (dono(uid) && request.resource.data.get('foto', '')
        == get(/databases/$(database)/documents/alunos/$(uid)).data.get('foto', ''));
    }

    // Liberação do curso: todos leem; só o professor muda.
    match /config/{doc} {
      allow read: if true;
      allow write: if professor();
    }

    // Turmas: a lista de escolas e turmas aparece na tela de login (antes de entrar).
    // Só o professor cria e apaga.
    match /turmas/{codigo} {
      allow read: if true;
      allow write: if professor();
    }
  }
}
